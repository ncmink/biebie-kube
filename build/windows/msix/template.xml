<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="biebie-kube"
        Arguments=""
        InstallLocation="C:\Program Files\Biebie\Biebie Kube">
    </Installer>
    <PackageInformation
        PackageName="net.biebie.kube"
        PackageDisplayName="Biebie Kube"
        PublisherName="CN=Biebie"
        PublisherDisplayName="Biebie"
        Version="0.2.0.0"
        PackageDescription="Kubernetes workspace for the biebie.net family.">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="BiebieKube"
                Description="Kubernetes workspace for the biebie.net family."
                DisplayName="Biebie Kube"
                ExecutableName="biebie-kube"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Biebie Kube</DisplayName>
            <PublisherDisplayName>Biebie</PublisherDisplayName>
            <Description>Kubernetes workspace for the biebie.net family.</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="biebie-kube.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
